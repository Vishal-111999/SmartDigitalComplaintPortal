PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/smart-complaints
CLIENT_URL=http://127.0.0.1:5173
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
NODE_ENV=development
# Set to the number of trusted reverse proxies in front of Express (for example, 1 behind one Nginx proxy).
TRUST_PROXY=0
# SMTP is required in every environment for registration verification.
# Configure it for password resets and resident update emails as well.
# Gmail example: smtp.gmail.com on port 587 with SMTP_SECURE=false and an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
